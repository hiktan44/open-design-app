# ==============================================================================
# OpenDesign Environment Configuration Example
# ==============================================================================
# GÜVENLİK NOTU: Bu dosya yalnızca şablon örnektir. Gerçek API anahtarlarını,
# tokenları ve şifreleri asla bu dosyaya veya Git'e kaydetmeyin.
# Yerel ortamınız için bu dosyayı `.env` olarak kopyalayınız.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Kimlik Doğrulama
# Google Cloud Console üzerinden oluşturulur:
# https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# İsteğe bağlı redirect URI (varsayılan: {origin}/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ------------------------------------------------------------------------------
# Sunucu & Ağ Yapılandırması (Coolify / Production)
# ------------------------------------------------------------------------------
# OD_PORT=7456
# OD_WEB_PORT=3000
# OD_HOST=0.0.0.0
# OD_PUBLIC_BASE_URL=https://your-opendesign-domain.com

# Coolify / Reverse Proxy ortamında loopback güvenlik kontrolünü gevşetmek için:
# OD_ALLOW_REMOTE_DAEMON=true

# ------------------------------------------------------------------------------
# Yapay Zeka Sağlayıcı API Anahtarları (İsteğe Bağlı)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OLLAMA_HOST=http://localhost:11434
